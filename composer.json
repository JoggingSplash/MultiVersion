{
    "name": "cisco/multiversion-encoding",
    "description": "PocketMine-MP MultiVersion using ext-encoding",
    "type": "project",
    "autoload": {},
    "require": {
        "ext-curl": "*",
        "ext-pmmpthread": "*",
        "ext-encoding": "*",
        "ext-chunkutils2": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "pocketmine/pocketmine-mp": "^5.0.0",
        "friendsofphp/php-cs-fixer": "^3.95"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "make-phar":  [
            "@composer install --no-dev --classmap-authoritative --ignore-platform-reqs",
            "@php -dphar.readonly=0 ./scripts/make-phar.php"
        ]
    }
}
